# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Neon POOLED connection (host contains "-pooler") — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon DIRECT connection (no "-pooler") — used by "prisma migrate"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs login sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the site (used for SEO links and sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
